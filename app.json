{
  "expo": {
    "name": "LGICT Support",
    "slug": "ticketing-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ictsupport",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.leoniogroup.ictsupport"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.leoniogroup.ictsupport"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f0e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of the problem to your IT support request.",
          "cameraPermission": "Take a photo of the problem for your IT support request.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2d5a2d",
          "defaultChannel": "default",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d51d3e93-5020-4bfe-ad99-49c63217454f"
      }
    },
    "owner": "crescian",
    "updates": {
      "url": "https://u.expo.dev/d51d3e93-5020-4bfe-ad99-49c63217454f"
    }
  }
}
