# Copy to .env.local (gitignored) and fill in.

# Defaults to production when unset.
# EXPO_PUBLIC_API_URL=https://ictsupportrequest.leoniogroup.com/api

# Azure AD mobile app registration (public client). Redirect URIs to add in Azure:
#   ictsupport://auth          (development and release builds)
#   exp://<your-ip>:8081/--/auth (Expo Go — printed in the Metro log on first use)
EXPO_PUBLIC_AZURE_TENANT_ID=
EXPO_PUBLIC_AZURE_CLIENT_ID=
